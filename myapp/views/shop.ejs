<%- include('partials/header') %>

<main class="container">
    <div class="breadcrumb" style="margin-bottom: 20px; font-size: 14px; color: #666;">
        <a href="/" style="text-decoration: none; color: var(--primary);">Trang chủ</a> / <span>Sản phẩm</span>
    </div>

    <div class="shop-layout">
        <aside class="sidebar">
            <div class="filter-group">
                <h3>Danh mục sản phẩm</h3>
                <ul class="filter-list">
                    <li>
                        <a href="/products" class="<%= !currentCategory ? 'active' : '' %>">
                            Tất cả sản phẩm
                        </a>
                    </li>
                    
                    <li>
                        <a href="/products?category=1" class="<%= currentCategory == 1 ? 'active' : '' %>">
                            Vật liệu trám
                        </a>
                    </li>
                    <li>
                        <a href="/products?category=2" class="<%= currentCategory == 2 ? 'active' : '' %>">
                            Thiết bị nội nha
                        </a>
                    </li>
                    <li>
                        <a href="/products?category=3" class="<%= currentCategory == 3 ? 'active' : '' %>">
                            Chỉnh nha - Niềng răng
                        </a>
                    </li>
                    <li>
                        <a href="/products?category=4" class="<%= currentCategory == 4 ? 'active' : '' %>">
                            Dụng cụ phẫu thuật
                        </a>
                    </li>
                    <li>
                        <a href="/products?category=5" class="<%= currentCategory == 5 ? 'active' : '' %>">
                            Vô trùng
                        </a>
                    </li>
                    <li>
                        <a href="/products?category=6" class="<%= currentCategory == 6 ? 'active' : '' %>">
                            Thiết bị chẩn đoán
                        </a>
                    </li>
                </ul>
            </div>
        </aside>

        <section class="shop-main">
            <div class="shop-toolbar" style="display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 15px 20px; border-radius: 10px; margin-bottom: 25px; border: 1px solid #eef2f3;">
                <h2 style="font-size: 18px; color: var(--primary);"><%= title %></h2>
                <div class="sort-options">
                    <select id="sort-select" onchange="changeSort(this.value)" style="padding: 8px; border-radius: 5px; border: 1px solid #ccc; outline: none; font-size: 14px; cursor: pointer;">
                        <option value="newest" <%= currentSort === 'newest' ? 'selected' : '' %>>Mới nhất</option>
                        <option value="price-asc" <%= currentSort === 'price-asc' ? 'selected' : '' %>>Giá tăng dần</option>
                        <option value="price-desc" <%= currentSort === 'price-desc' ? 'selected' : '' %>>Giá giảm dần</option>
                    </select>
                </div>
            </div>

            <div class="product-grid">
                <% if (products && products.length > 0) { %>
                    <% products.forEach(function(item) { %>
                        <div class="product-card">
                            <div class="product-img">
                                <img src="/images/<%= item.main_image %>" onerror="this.src='https://via.placeholder.com/250x250?text=Sản+phẩm'" alt="<%= item.name %>">
                            </div>
                            <div class="product-info">
                                <h3 style="font-size: 15px; min-height: 40px;"><%= item.name %></h3>
                                <p class="price" style="color: #e74c3c; font-weight: bold; margin-bottom: 15px;">
                                    <%= item.price.toLocaleString('vi-VN') %> đ
                                </p>
                                <div class="product-actions">
                                    <a href="/products/<%= item.id %>" class="btn-detail">Chi tiết</a>
                                    <button class="btn-buy">Mua ngay</button>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div style="grid-column: span 3; text-align: center; padding: 50px; background: #fff; border-radius: 10px;">
                        <i class="fas fa-box-open" style="font-size: 40px; color: #ccc; margin-bottom: 15px;"></i>
                        <p style="color: #666;">Hiện chưa có sản phẩm nào trong danh mục này.</p>
                    </div>
                <% } %>
            </div>
        </section>
    </div>
</main>

<script>
    function changeSort(sortValue) {
        const url = new URL(window.location.href);
        url.searchParams.set('sort', sortValue); // Thêm hoặc cập nhật tham số ?sort=
        window.location.href = url.href; // Tải lại trang với bộ lọc mới
    }
</script>

<%- include('partials/footer') %>