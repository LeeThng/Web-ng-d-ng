<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Vật Liệu Nha Khoa - Danh Sách</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <header>
        <div class="logo">DENTAL SHOP</div>
        <nav class="nav-links">
            <a href="/">Trang chủ</a>
            <a href="/products">Sản phẩm</a>
            <a href="/cart">Giỏ hàng</a>
        </nav>
    </header>

    <div class="container">
        <h1>Sản phẩm của chúng tôi</h1>
        <div class="product-grid">
            <!-- Một mẫu sản phẩm -->
            <div class="product-card">
                <img src="https://via.placeholder.com/200" alt="Vật liệu">
                <h3>Kìm nhổ răng trẻ em</h3>
                <p style="color: red; font-weight: bold;">1.500.000 VNĐ</p>
                <button class="btn-buy">Chi tiết</button>
            </div>
            
            <div class="product-card">
                <img src="https://via.placeholder.com/200" alt="Vật liệu">
                <h3>Composite trám răng</h3>
                <p style="color: red; font-weight: bold;">800.000 VNĐ</p>
                <button class="btn-buy">Chi tiết</button>
            </div>
        </div>
    </div>
</body>
</html>