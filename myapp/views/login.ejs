<%- include('partials/header') %>

<div class="container" style="max-width: 450px; margin: 60px auto; background: #fff; padding: 40px; border-radius: 10px; box-shadow: 0 5px 20px rgba(0,0,0,0.05);">
    <h2 style="text-align: center; color: var(--primary); margin-bottom: 30px;">Đăng Nhập</h2>

    <% if (error) { %>
        <div style="background: #ffe6e6; color: #d9534f; padding: 10px; border-radius: 5px; margin-bottom: 20px; text-align: center; border: 1px solid #d9534f;">
            <%= error %>
        </div>
    <% } %>

    <form action="/login" method="POST">
        <div style="margin-bottom: 20px;">
            <label style="display: block; margin-bottom: 8px; font-weight: bold;">Email</label>
            <input type="email" name="email" required style="width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 5px;">
        </div>

        <div style="margin-bottom: 25px;">
            <label style="display: block; margin-bottom: 8px; font-weight: bold;">Mật khẩu</label>
            <input type="password" name="password" required style="width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 5px;">
        </div>

        <button type="submit" class="btn-buy-now" style="width: 100%; padding: 15px; border: none; cursor: pointer;">
            Đăng nhập ngay
        </button>
    </form>

    <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee; text-align: center;">
        <p style="color: #666; margin-bottom: 15px;">Chưa có tài khoản vật liệu nha khoa?</p>
        <a href="/register" style="display: block; padding: 12px; border: 2px solid var(--primary); color: var(--primary); text-decoration: none; border-radius: 5px; font-weight: bold; transition: 0.3s;">
            Tạo tài khoản mới
        </a>
    </div>
</div>

<%- include('partials/footer') %>