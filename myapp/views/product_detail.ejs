<%- include('partials/header') %>

<main class="container">
    <div class="breadcrumb" style="margin-bottom: 20px; font-size: 14px; color: #666;">
        <a href="/" style="text-decoration: none; color: var(--primary);">Trang chủ</a> / 
        <a href="/products" style="text-decoration: none; color: var(--primary);">Sản phẩm</a> / 
        <span><%= product.name %></span>
    </div>

    <div class="detail-container">
        <div class="product-gallery">
            <div class="main-image">
                <img id="featured-image" src="/images/<%= product.main_image %>" 
                     onerror="this.src='https://via.placeholder.com/500x500?text=Onyx+Dental'"
                     alt="<%= product.name %>" style="width: 100%; border-radius: 10px; border: 1px solid #eee;">
            </div>
            
            <% if (product.images && product.images.length > 0) { %>
                <div class="thumbnail-list" style="display: flex; gap: 10px; margin-top: 15px; overflow-x: auto; padding-bottom: 5px;">
                    <img src="/images/<%= product.main_image %>" class="active-thumb" 
                         onclick="changeImage(this)" 
                         style="width: 80px; height: 80px; object-fit: cover; cursor: pointer; border: 2px solid var(--primary); border-radius: 5px;">
                    <% product.images.forEach(function(img) { %>
                        <img src="/images/<%= img.image_url %>" onclick="changeImage(this)" 
                             style="width: 80px; height: 80px; object-fit: cover; cursor: pointer; border: 2px solid #eee; border-radius: 5px; transition: 0.3s;">
                    <% }); %>
                </div>
            <% } %>
        </div>

        <div class="product-summary">
            <h1 class="product-title" style="color: var(--primary); font-size: 28px; margin-bottom: 10px;"><%= product.name %></h1>
            
            <div class="product-meta" style="margin-bottom: 20px; color: #777; font-size: 14px;">
                <span>Danh mục: <strong><%= product.category_name %></strong></span>
                <span style="margin: 0 10px;">|</span>
                <span>Mã sản phẩm: <strong>ONYX-<%= product.id %></strong></span>
            </div>

            <div class="product-price-box" style="background: #f4f7f6; padding: 20px; border-radius: 10px; margin-bottom: 25px;">
                <span class="price-detail" style="font-size: 32px; font-weight: bold; color: #e74c3c;">
                    <%= product.price.toLocaleString('vi-VN') %> đ
                </span>
                <% if (product.old_price && product.old_price > product.price) { %>
                    <span class="old-price" style="text-decoration: line-through; color: #999; margin-left: 15px; font-size: 18px;">
                        <%= product.old_price.toLocaleString('vi-VN') %> đ
                    </span>
                    <span style="background: #e74c3c; color: white; padding: 3px 8px; border-radius: 5px; font-size: 14px; margin-left: 10px; font-weight: bold;">
                        -<%= Math.round((1 - product.price / product.old_price) * 100) %>%
                    </span>
                <% } %>
            </div>

            <p class="short-desc" style="line-height: 1.6; color: #444; margin-bottom: 30px;">
                <%= product.description ? product.description.substring(0, 200) + '...' : 'Vật liệu nha khoa cao cấp chính hãng, đảm bảo độ bền và an toàn sinh học tuyệt đối cho bệnh nhân.' %>
            </p>

            <form action="/cart/add" method="POST">
                <input type="hidden" name="productId" value="<%= product.id %>">
                
                <div class="quantity-section" style="display: flex; align-items: center; gap: 20px; margin-bottom: 30px;">
                    <label style="font-weight: bold; color: var(--text-dark);">Số lượng:</label>
                    <div class="qty-control" style="display: flex; border: 1px solid #ccc; border-radius: 5px; overflow: hidden; background: #fff;">
                        <button type="button" class="qty-btn" onclick="updateQty(-1)" style="width: 40px; height: 40px; border: none; background: #eee; cursor: pointer; font-size: 18px;">-</button>
                        <input type="number" id="quantity" name="quantity" class="qty-input" value="1" min="1" 
                               style="width: 60px; text-align: center; border: none; font-weight: bold; font-size: 16px; outline: none;">
                        <button type="button" class="qty-btn" onclick="updateQty(1)" style="width: 40px; height: 40px; border: none; background: #eee; cursor: pointer; font-size: 18px;">+</button>
                    </div>
                    <span style="color: #27ae60; font-weight: bold; font-size: 14px;"><i class="fas fa-check-circle"></i> Còn hàng</span>
                </div>

                <div class="action-buttons" style="display: flex; gap: 15px;">
                    <button type="submit" class="btn-add-cart-large" style="flex: 1; padding: 15px; border: 2px solid var(--primary); background: #fff; color: var(--primary); font-weight: bold; border-radius: 8px; cursor: pointer; transition: 0.3s; display: flex; align-items: center; justify-content: center; gap: 10px;">
                        <i class="fas fa-cart-plus"></i> THÊM VÀO GIỎ
                    </button>
                    <button type="button" class="btn-buy-now" style="flex: 1; padding: 15px; background: var(--primary); color: #fff; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; transition: 0.3s; font-size: 16px;">
                        MUA NGAY
                    </button>
                </div>
            </form>
            
            <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee; display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                <div style="font-size: 13px; color: #555;"><i class="fas fa-truck" style="color: var(--secondary);"></i> Giao hàng hỏa tốc 24h</div>
                <div style="font-size: 13px; color: #555;"><i class="fas fa-shield-alt" style="color: var(--secondary);"></i> Bảo hành chính hãng</div>
                <div style="font-size: 13px; color: #555;"><i class="fas fa-undo" style="color: var(--secondary);"></i> Đổi trả trong 7 ngày</div>
                <div style="font-size: 13px; color: #555;"><i class="fas fa-headset" style="color: var(--secondary);"></i> Hỗ trợ kỹ thuật 24/7</div>
            </div>
        </div>
    </div>

    <div class="description-section" style="margin-top: 50px; background: #fff; padding: 30px; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.05);">
        <div class="desc-tabs" style="border-bottom: 2px solid #f0f0f0; margin-bottom: 25px; display: flex; gap: 30px;">
            <button class="tab-btn active" onclick="openTab(event, 'description')" style="background: none; border: none; padding: 10px 0; font-size: 18px; font-weight: bold; color: #666; cursor: pointer; position: relative;">Mô tả sản phẩm</button>
            <button class="tab-btn" onclick="openTab(event, 'specs')" style="background: none; border: none; padding: 10px 0; font-size: 18px; font-weight: bold; color: #666; cursor: pointer; position: relative;">Thông số kỹ thuật</button>
        </div>

        <div id="description" class="tab-content" style="display: block; line-height: 1.8; color: #444; font-size: 16px;">
            <p><%= product.description %></p>
        </div>

        <div id="specs" class="tab-content" style="display: none; line-height: 1.8; color: #444;">
            <table style="width: 100%; border-collapse: collapse; border: 1px solid #eee;">
                <tr style="background: #f9f9f9;">
                    <td style="padding: 12px 20px; font-weight: bold; width: 30%; border: 1px solid #eee;">Xuất xứ</td>
                    <td style="padding: 12px 20px; border: 1px solid #eee;">Chính hãng ONYX Dental</td>
                </tr>
                <tr>
                    <td style="padding: 12px 20px; font-weight: bold; border: 1px solid #eee;">Quy cách đóng gói</td>
                    <td style="padding: 12px 20px; border: 1px solid #eee;">Hộp / Bộ tiêu chuẩn y tế</td>
                </tr>
                <tr style="background: #f9f9f9;">
                    <td style="padding: 12px 20px; font-weight: bold; border: 1px solid #eee;">Chứng nhận chất lượng</td>
                    <td style="padding: 12px 20px; border: 1px solid #eee;">ISO 13485, CE 0123</td>
                </tr>
                <tr>
                    <td style="padding: 12px 20px; font-weight: bold; border: 1px solid #eee;">Ứng dụng lâm sàng</td>
                    <td style="padding: 12px 20px; border: 1px solid #eee;">Sử dụng trong nha khoa chuyên nghiệp</td>
                </tr>
            </table>
        </div>
    </div>
</main>

<script>
    // Hàm chuyển đổi ảnh chính
    function changeImage(element) {
        document.getElementById('featured-image').src = element.src;
        document.querySelectorAll('.thumbnail-list img').forEach(img => {
            img.style.borderColor = '#eee';
            img.classList.remove('active-thumb');
        });
        element.style.borderColor = 'var(--primary)';
        element.classList.add('active-thumb');
    }

    // Hàm tăng giảm số lượng
    function updateQty(change) {
        const input = document.getElementById('quantity');
        let newVal = parseInt(input.value) + change;
        if (newVal < 1) newVal = 1;
        input.value = newVal;
    }

    // Hàm xử lý chuyển đổi Tab
    function openTab(evt, tabName) {
        var i, tabContent, tabButtons;
        tabContent = document.getElementsByClassName("tab-content");
        for (i = 0; i < tabContent.length; i++) {
            tabContent[i].style.display = "none";
        }
        tabButtons = document.getElementsByClassName("tab-btn");
        for (i = 0; i < tabButtons.length; i++) {
            tabButtons[i].classList.remove("active");
            tabButtons[i].style.color = "#666";
        }
        document.getElementById(tabName).style.display = "block";
        evt.currentTarget.classList.add("active");
        evt.currentTarget.style.color = "var(--primary)";
    }
</script>

<%- include('partials/footer') %>